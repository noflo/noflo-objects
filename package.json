{
  "name": "@noflo/objects",
  "description": "Object Utilities for NoFlo",
  "version": "2.0.0-alpha.1",
  "keywords": [
    "noflo",
    "objects",
    "utilities"
  ],
  "author": "Kenneth Kan <kenhkan@gmail.com>",
  "contributors": [
    {
      "name": "Henri Bergius",
      "email": "henri.bergius@iki.fi"
    },
    {
      "name": "Ryan Shaw",
      "email": "ryanshaw@unc.edu"
    },
    {
      "name": "James",
      "email": "aretecode@gmail.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noflo/noflo-objects.git"
  },
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.2",
    "jsonpath": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.2",
    "@noflo/loader-node": "^2.0.0-alpha.2",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "noflo": {
    "icon": "list"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ spec/ test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ spec/ test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec && npm run test:node",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "components/",
    "spec/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
